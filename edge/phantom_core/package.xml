<?xml version="1.0"?>
<package format="3">
  <name>phantom_core</name>
  <version>1.0.0</version>
  <description>PhantomCore™ — EKF-based state estimation for PhantomNav</description>
  <maintainer email="eng@phantomorg.dev">PhantomOrg Engineering</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>phantom_msgs</depend>

  <build_depend>eigen3_cmake_module</build_depend>
  <build_depend>Eigen3</build_depend>

  <exec_depend>eigen3_cmake_module</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
